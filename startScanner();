    resultBox
      .classList
      .add(
        "success"
      );


    document
      .getElementById(
        "resultTitle"
      )
      .textContent =
      "✓ ARRIVAL RECORDED";


    document
      .getElementById(
        "lateText"
      )
      .textContent =
