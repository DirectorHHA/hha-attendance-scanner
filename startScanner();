<script>

  // ====================================================
  // CONFIGURATION
  // ====================================================

  const API_URL =
    "https://script.google.com/macros/s/AKfycbwaf9whfdcgbS8NgulecjKObihESdn05B3RhX8ERO5rR0R8ccpelLliGmuVy8l8xzXsJg/exec";


  const DB_NAME =
    "HHA_Attendance_Scanner_V2";


  const DB_VERSION =
    1;


  const STORE_NAME =
    "scanTransactions";


  const INITIAL_RESPONSE_TIMEOUT_MS =
    15000;


  const VERIFY_INTERVAL_MS =
    5000;


  const VERIFY_ATTEMPTS =
    6;


  const RETRY_INTERVAL_MS =
  30000;


  /*
   * The same physical QR cannot start another
   * transaction while its earlier transaction
   * is unresolved.
   */

 const LOCAL_QR_COOLDOWN_MS =
  90000;


  // ====================================================
  // STATE
  // ====================================================

  let db =
    null;


  let scanLocked =
    false;


  let activeTransactionId =
    "";

  /*
 * DISPLAY OWNERSHIP
 *
 * Identifies the most recently captured transaction.
 * Background responses belonging to older transactions
 * must never overwrite the current scanner display.
 */

let latestCaptureTransactionId =
  "";

  let retryTimer =
  null;


/*
 * QUEUE WORKER MUTEX
 *
 * Only ONE synchronisation worker may process the
 * local offline queue at any time.
 */

let syncWorkerRunning =
  false;


let scanner =
  null;
  /*
 * CAMERA-LEVEL REPEAT PROTECTION
 *
 * IndexedDB remains the durable duplicate defence.
 * This additional memory lock stops repeated camera
 * callbacks from creating unnecessary transactions
 * while the same QR remains in front of the lens.
 */

let lastCameraToken =
  "";

let lastCameraTokenAt =
  0;

const CAMERA_REPEAT_BLOCK_MS =
  90000;

  // ====================================================
  // STARTUP
  // ====================================================

  window.addEventListener(
    "load",
    initialiseScannerApp
  );


  async function initialiseScannerApp() {

    updateNetworkStatus();


    window.addEventListener(
      "online",
      function() {

        updateNetworkStatus();

        synchronisePendingTransactions();
      }
    );


    window.addEventListener(
      "offline",
      updateNetworkStatus
    );


    try {

      db =
        await openScanDatabase();


      await updateRegistryCounts();


     const unresolved =
  await getOldestUnresolvedTransaction();


if (unresolved) {

  /*
   * NON-BLOCKING STARTUP RECOVERY
   *
   * An unresolved transaction must never prevent
   * the camera from accepting new attendance scans.
   *
   * The transaction remains safely stored locally
   * and the background worker will synchronise it
   * independently.
   */

  activeTransactionId =
    "";


  scanLocked =
    false;


  showPendingTransaction(
    unresolved,
    navigator.onLine
      ? "SAVED SCAN PENDING SYNC"
      : "OFFLINE SCANS SAFELY STORED"
  );


  setStatus(
    navigator.onLine
      ? "READY FOR NEXT QR — saved attendance is synchronising in the background."
      : "OFFLINE — READY FOR NEXT QR. Saved scans will sync automatically.",
    "waiting"
  );


  /*
   * Start background recovery without waiting for it.
   */

  if (navigator.onLine) {

    setTimeout(
      synchronisePendingTransactions,
      500
    );
  }

} else {

  setStatus(
    "Starting camera…"
  );
}


startScanner();


scheduleRetryLoop();


    } catch (
      error
    ) {

      console.error(
        "Scanner startup error:",
        error
      );


      showCriticalError(
        "The local scan registry could not start. Attendance scanning has been disabled to prevent lost scans."
      );
    }
  }


  // ====================================================
  // INDEXEDDB
  // ====================================================

  function openScanDatabase() {

    return new Promise(
      function(
        resolve,
        reject
      ) {

        const request =
          indexedDB.open(
            DB_NAME,
            DB_VERSION
          );


        request.onupgradeneeded =
          function(event) {

            const database =
              event.target.result;


            if (
              !database.objectStoreNames.contains(
                STORE_NAME
              )
            ) {

              const store =
                database.createObjectStore(
                  STORE_NAME,
                  {
                    keyPath:
                      "transactionId"
                  }
                );


              store.createIndex(
                "status",
                "status",
                {
                  unique: false
                }
              );


              store.createIndex(
                "token",
                "token",
                {
                  unique: false
                }
              );


              store.createIndex(
                "capturedAtMs",
                "capturedAtMs",
                {
                  unique: false
                }
              );
            }
          };


        request.onsuccess =
          function(event) {

            resolve(
              event.target.result
            );
          };


        request.onerror =
          function() {

            reject(
              request.error
            );
          };
      }
    );
  }


  function saveLocalTransaction(
    transaction
  ) {

    return new Promise(
      function(
        resolve,
        reject
      ) {

        if (!db) {

          reject(
            new Error(
              "Local scan registry is unavailable."
            )
          );

          return;
        }


        const tx =
          db.transaction(
            STORE_NAME,
            "readwrite"
          );


        const store =
          tx.objectStore(
            STORE_NAME
          );


        store.put(
          transaction
        );


        tx.oncomplete =
          function() {

            resolve(
              transaction
            );
          };


        tx.onerror =
          function() {

            reject(
              tx.error
            );
          };
      }
    );
  }


  function getLocalTransaction(
    transactionId
  ) {

    return new Promise(
      function(
        resolve,
        reject
      ) {

        const tx =
          db.transaction(
            STORE_NAME,
            "readonly"
          );


        const request =
          tx
            .objectStore(
              STORE_NAME
            )
            .get(
              transactionId
            );


        request.onsuccess =
          function() {

            resolve(
              request.result ||
              null
            );
          };


        request.onerror =
          function() {

            reject(
              request.error
            );
          };
      }
    );
  }


  function getAllLocalTransactions() {

    return new Promise(
      function(
        resolve,
        reject
      ) {

        const tx =
          db.transaction(
            STORE_NAME,
            "readonly"
          );


        const request =
          tx
            .objectStore(
              STORE_NAME
            )
            .getAll();


        request.onsuccess =
          function() {

            resolve(
              request.result ||
              []
            );
          };


        request.onerror =
          function() {

            reject(
              request.error
            );
          };
      }
    );
  }


  async function getOldestUnresolvedTransaction() {

    const records =
      await getAllLocalTransactions();


    const unresolved =
      records
        .filter(
          function(record) {

            return (
              record.status ===
                "PENDING" ||
              record.status ===
                "VERIFYING" ||
              record.status ===
                "BUSY"
            );
          }
        )
        .sort(
          function(a, b) {

            return (
              Number(
                a.capturedAtMs || 0
              ) -
              Number(
                b.capturedAtMs || 0
              )
            );
          }
        );


    return (
      unresolved.length
        ? unresolved[0]
        : null
    );
  }

  /*
 * Return a snapshot of all unresolved attendance
 * transactions in capture order.
 *
 * The synchronisation worker uses this snapshot so
 * one difficult transaction cannot prevent later
 * locally-saved scans from receiving a sync attempt.
 */

async function getUnresolvedTransactionQueue() {

  const records =
    await getAllLocalTransactions();


  return records
    .filter(
      function(record) {

        return (
          record.status === "PENDING" ||
          record.status === "VERIFYING" ||
          record.status === "BUSY"
        );
      }
    )
    .sort(
      function(a, b) {

        return (
          Number(
            a.capturedAtMs || 0
          ) -
          Number(
            b.capturedAtMs || 0
          )
        );
      }
    );
}

  // ====================================================
  // CAMERA
  // ====================================================

  function startScanner() {

    scanner =
      new Html5Qrcode(
        "reader"
      );


    const config = {

      fps: 10,

      qrbox:
        function(
          viewfinderWidth,
          viewfinderHeight
        ) {

          const size =
            Math.floor(
              Math.min(
                viewfinderWidth,
                viewfinderHeight
              ) * 0.72
            );


          return {
            width: size,
            height: size
          };
        }
    };


    scanner
      .start(
        {
          facingMode:
            "environment"
        },

        config,

        onScanSuccess,

        function() {}
      )
      .then(
        function() {

          if (!scanLocked) {

            setStatus(
              "READY — Scan a student or staff QR card"
            );
          }
        }
      )
      .catch(
        function(error) {

          console.error(
            error
          );


          setStatus(
            "Camera could not start: " +
            (
              error &&
              error.message
                ? error.message
                : String(error)
            )
          );
        }
      );
  }


  async function onScanSuccess(
  decodedText
) {

  if (scanLocked) {
    return;
  }


  const token =
    String(
      decodedText || ""
    ).trim();


  if (!token) {
    return;
  }


  const now =
    Date.now();


  /*
   * Stop repeated camera callbacks for the same
   * physical QR before they can create another
   * transaction.
   */

  if (
    token === lastCameraToken &&
    (
      now -
      lastCameraTokenAt
    ) < CAMERA_REPEAT_BLOCK_MS
  ) {

    return;
  }


  /*
   * Reserve this QR immediately.
   *
   * Do this BEFORE awaiting IndexedDB so a second
   * camera callback cannot slip through while the
   * first capture is being stored.
   */

  lastCameraToken =
    token;

  lastCameraTokenAt =
    now;


  await captureScan(
    token
  );
}

  // ====================================================
  // CAPTURE SCAN LOCALLY FIRST
  // ====================================================

  async function captureScan(
    token
  ) {

    if (
      scanLocked ||
      !db
    ) {

      return;
    }


    scanLocked =
      true;


    try {

      const recent =
        await findRecentTokenTransaction(
          token
        );


      if (recent) {

        showWarning(
          "QR ALREADY CAPTURED",
          "This QR was recently scanned. Do not scan it again.",
          recent.transactionId
        );


        setStatus(
          "Duplicate local scan blocked"
        );


        /*
 * The duplicate has already been safely blocked.
 * Release capture immediately so a different person
 * can scan without waiting.
 */

activeTransactionId =
  "";

scanLocked =
  false;


return;
      }


      const transactionId =
  createTransactionId();


activeTransactionId =
  transactionId;


/*
 * This is now the newest attendance capture and
 * therefore owns the main result display.
 */

latestCaptureTransactionId =
  transactionId;


      const capturedDate =
        new Date();


      const scannerDevice =
        document
          .getElementById(
            "scannerDevice"
          )
          .value;


      const transaction = {

        transactionId:
          transactionId,

        token:
          token,

        scannerDevice:
          scannerDevice,

        capturedAt:
          capturedDate.toISOString(),

        capturedAtMs:
          capturedDate.getTime(),

        status:
          "PENDING",

        attempts:
          0,

        lastAttemptAt:
          "",

        backendResult:
          null,

        updatedAt:
          capturedDate.toISOString()
      };


      /*
       * CRITICAL:
       *
       * The scan is committed to IndexedDB BEFORE
       * any network request is attempted.
       */

      await saveLocalTransaction(
        transaction
      );


      await updateRegistryCounts();


      showPendingTransaction(
        transaction,
        "✓ SCAN SAVED"
      );


     if (!navigator.onLine) {

  /*
   * OFFLINE MULTI-SCAN MODE
   *
   * This transaction is already safely committed
   * to IndexedDB.
   *
   * Release the camera for the NEXT PERSON while
   * retaining this transaction in the pending queue.
   */

  showPendingTransaction(
    transaction,
    "✓ SCAN SAVED OFFLINE"
  );


  setStatus(
  "QR SAVED OFFLINE — move this card away from the camera",
  "waiting"
);


  /*
   * Clear only the active UI transaction.
   * The transaction itself remains safely stored
   * in IndexedDB as PENDING.
   */

  activeTransactionId =
  "";


/*
 * The transaction is already safely stored locally.
 * Release capture immediately so the next person
 * can scan without waiting for network access.
 */

scanLocked =
  false;


setStatus(
  "OFFLINE — READY FOR NEXT PERSON",
  "waiting"
);


return;
}


      /*
 * NON-BLOCKING CAPTURE
 *
 * The attendance transaction is already safely
 * committed to IndexedDB.
 *
 * Network synchronisation must never hold the
 * camera. Release capture immediately and allow
 * the queue worker to synchronise independently.
 */

showPendingTransaction(
  transaction,
  "✓ SCAN SAVED"
);


setStatus(
  "SCAN SAVED — READY FOR NEXT PERSON",
  "waiting"
);


/*
 * This transaction no longer owns the scanner UI.
 * It remains safely stored in IndexedDB.
 */

activeTransactionId =
  "";


scanLocked =
  false;


/*
 * Start/reuse the single background worker.
 *
 * Do NOT await this call. Server latency must not
 * delay the next QR capture.
 */

synchronisePendingTransactions();


    } catch (
      error
    ) {

      console.error(
        "Capture error:",
        error
      );


      /*
       * If IndexedDB itself failed, we cannot
       * truthfully claim that the scan is saved.
       */

      showCriticalError(
        "The scanner could not safely save this QR scan. Please contact the administrator before continuing."
      );


      scanLocked =
        true;
    }
  }


  // ====================================================
  // LOCAL DUPLICATE PROTECTION
  // ====================================================

  async function findRecentTokenTransaction(
    token
  ) {

    const records =
      await getAllLocalTransactions();


    const now =
      Date.now();


    const matching =
      records
        .filter(
          function(record) {

            return (
              String(
                record.token || ""
              ).trim() ===
                String(
                  token || ""
                ).trim() &&

              (
                now -
                Number(
                  record.capturedAtMs || 0
                )
              ) <
                LOCAL_QR_COOLDOWN_MS
            );
          }
        )
        .sort(
          function(a, b) {

            return (
              Number(
                b.capturedAtMs || 0
              ) -
              Number(
                a.capturedAtMs || 0
              )
            );
          }
        );


    return (
      matching.length
        ? matching[0]
        : null
    );
  }


  // ====================================================
  // SEND / VERIFY TRANSACTION
  // ====================================================

  async function processLocalTransaction(
    transactionId
  ) {

    const transaction =
      await getLocalTransaction(
        transactionId
      );


    if (!transaction) {
      return;
    }


    if (
      transaction.status ===
        "SYNCED" ||
      transaction.status ===
        "REJECTED" ||
      transaction.status ===
        "ATTENTION"
    ) {

      return;
    }


    if (!navigator.onLine) {

      transaction.status =
        "PENDING";

      transaction.updatedAt =
        new Date().toISOString();


      await saveLocalTransaction(
        transaction
      );


      await updateRegistryCounts();


      /*
 * The transaction remains safely stored locally.
 * Do not take over the scanner UI simply because
 * synchronisation discovered that connectivity
 * has disappeared.
 */

await updateRegistryCounts();


      return;
    }


    transaction.attempts =
      Number(
        transaction.attempts || 0
      ) + 1;


    transaction.lastAttemptAt =
      new Date().toISOString();


    transaction.status =
      "VERIFYING";


    transaction.updatedAt =
      new Date().toISOString();


    await saveLocalTransaction(
      transaction
    );


    await updateRegistryCounts();


    /*
 * Synchronisation happens in the background.
 *
 * Do not overwrite the main scanner display here.
 * The operator must remain free to scan the next
 * student while this transaction is processed.
 */

await updateRegistryCounts();


    /*
     * First check whether this transaction already
     * completed during an earlier attempt.
     */

    const knownStatus =
      await requestTransactionStatus(
        transaction.transactionId
      );


    if (
      await applyBackendStatus(
        transaction,
        knownStatus
      )
    ) {

      return;
    }


    /*
     * Not found means the backend has not seen it.
     * Submit the SAME transaction ID.
     */

    const submitResult =
      await submitTransactionToBackend(
        transaction
      );


    if (
      await applyBackendStatus(
        transaction,
        submitResult
      )
    ) {

      return;
    }


    /*
     * Response was uncertain.
     * Verify independently rather than telling the
     * user that attendance failed.
     */

    await verifyTransactionUntilResolved(
      transaction.transactionId
    );
  }


  // ====================================================
  // SUBMIT TRANSACTION
  // ====================================================

  function submitTransactionToBackend(
    transaction
  ) {

    const params = {

      action:
        "scan",

      token:
        transaction.token,

      scanner:
        transaction.scannerDevice,

      transaction:
        transaction.transactionId,

      capturedAt:
        transaction.capturedAt
    };


    return jsonpRequest(
      params,
      INITIAL_RESPONSE_TIMEOUT_MS
    );
  }


  // ====================================================
  // STATUS REQUEST
  // ====================================================

  function requestTransactionStatus(
    transactionId
  ) {

    return jsonpRequest(
      {
        action:
          "scanstatus",

        transaction:
          transactionId
      },
      10000
    );
  }


  // ====================================================
  // JSONP REQUEST
  // ====================================================

  function jsonpRequest(
    params,
    timeoutMs
  ) {

    return new Promise(
      function(resolve) {

        const callbackName =
          "hhaCallback_" +
          Date.now() +
          "_" +
          Math.floor(
            Math.random() *
            1000000
          );


        const script =
          document.createElement(
            "script"
          );


        let finished =
          false;


        const timeout =
          setTimeout(
            function() {

              if (finished) {
                return;
              }


              finished =
                true;


              cleanup();


              resolve(
                {
                  communicationUncertain:
                    true,

                  status:
                    "COMMUNICATION_TIMEOUT",

                  message:
                    "Server acknowledgement was delayed."
                }
              );

            },
            timeoutMs
          );


        window[callbackName] =
          function(result) {

            if (finished) {
              return;
            }


            finished =
              true;


            cleanup();


            resolve(
              result || {
                communicationUncertain:
                  true,

                status:
                  "EMPTY_RESPONSE"
              }
            );
          };


        function cleanup() {

          clearTimeout(
            timeout
          );


          try {

            delete window[
              callbackName
            ];

          } catch (
            ignore
          ) {}


          if (
            script.parentNode
          ) {

            script
              .parentNode
              .removeChild(
                script
              );
          }
        }


        const query =
          Object.keys(
            params
          )
            .map(
              function(key) {

                return (
                  encodeURIComponent(
                    key
                  ) +
                  "=" +
                  encodeURIComponent(
                    params[key]
                  )
                );
              }
            )
            .join("&");


        script.src =
          API_URL +
          "?" +
          query +
          "&callback=" +
          encodeURIComponent(
            callbackName
          ) +
          "&t=" +
          Date.now();


        script.onerror =
          function() {

            if (finished) {
              return;
            }


            finished =
              true;


            cleanup();


            resolve(
              {
                communicationUncertain:
                  true,

                status:
                  "NETWORK_ERROR",

                message:
                  "Unable to confirm the server response."
              }
            );
          };


        document.body.appendChild(
          script
        );
      }
    );
  }


  // ====================================================
  // APPLY BACKEND STATUS
  // ====================================================

  async function applyBackendStatus(
    transaction,
    result
  ) {

    if (!result) {
      return false;
    }


    /*
     * COMPLETED
     */

    if (
      result.status ===
        "COMPLETED"
    ) {

      transaction.status =
        "SYNCED";

      transaction.backendResult =
        result;

      transaction.updatedAt =
        new Date().toISOString();


      await saveLocalTransaction(
        transaction
      );


      await updateRegistryCounts();


      const attendance =
        result.attendance ||
        result;


     /*
 * Only show the server result if this is still the
 * newest QR captured by the operator.
 *
 * Older transactions continue to complete normally
 * in IndexedDB without hijacking the display.
 */

if (
  transaction.transactionId ===
  latestCaptureTransactionId
) {

  showAttendanceResult(
    attendance,
    transaction.transactionId
  );
}


finishResolvedTransaction(
  transaction.transactionId
);


      return true;
    }


    /*
     * REJECTED
     *
     * This is a definite backend decision.
     */

    if (
      result.status ===
        "REJECTED"
    ) {

      transaction.status =
        "REJECTED";

      transaction.backendResult =
        result;

      transaction.updatedAt =
        new Date().toISOString();


      await saveLocalTransaction(
        transaction
      );


      await updateRegistryCounts();


      const attendance =
        result.attendance ||
        result;


      if (
  transaction.transactionId ===
  latestCaptureTransactionId
) {

  showRejectedResult(
    attendance,
    transaction.transactionId
  );
}


      finishResolvedTransaction(
        transaction.transactionId
      );


      return true;
    }


    /*
     * UNKNOWN
     *
     * Human review is safer than resubmission.
     */

    if (
      result.status ===
        "UNKNOWN"
    ) {

      transaction.status =
        "ATTENTION";

      transaction.backendResult =
        result;

      transaction.updatedAt =
        new Date().toISOString();


      await saveLocalTransaction(
        transaction
      );


      await updateRegistryCounts();


      if (
  transaction.transactionId ===
  latestCaptureTransactionId
) {

  showAttention(
    "ATTENDANCE NEEDS VERIFICATION",
    result.message ||
    "The server could not safely determine the final attendance state.",
    transaction.transactionId
  );


  setStatus(
    "This scan needs administrator verification — scanner remains ready for the next person.",
    "waiting"
  );
}


/*
 * This transaction is isolated as ATTENTION.
 * It must never disable attendance capture for
 * other students or staff.
 */

return true;
    }


    /*
     * BUSY / NOT_FOUND / PROCESSING /
     * communication failure remain unresolved.
     */

    return false;
  }


  // ====================================================
  // VERIFY UNTIL RESOLVED
  // ====================================================

  async function verifyTransactionUntilResolved(
    transactionId
  ) {

    for (
      let attempt = 0;
      attempt < VERIFY_ATTEMPTS;
      attempt++
    ) {

      if (!navigator.onLine) {
        break;
      }


      await delay(
        VERIFY_INTERVAL_MS
      );


      const transaction =
        await getLocalTransaction(
          transactionId
        );


      if (!transaction) {
        return;
      }


      /*
 * Verification is a background operation.
 *
 * Do not display "VERIFYING ATTENDANCE" on the
 * main scanner interface because this transaction
 * must not interrupt capture of the next person.
 */

await updateRegistryCounts();


      const statusResult =
        await requestTransactionStatus(
          transactionId
        );


      if (
        await applyBackendStatus(
          transaction,
          statusResult
        )
      ) {

        return;
      }
    }


    /*
     * Still unresolved.
     *
     * Keep it pending and let the retry loop use the
     * SAME transaction later.
     */

    const transaction =
      await getLocalTransaction(
        transactionId
      );


    if (!transaction) {
      return;
    }


    transaction.status =
      "PENDING";

    transaction.updatedAt =
      new Date().toISOString();


    await saveLocalTransaction(
      transaction
    );


    await updateRegistryCounts();


/*
 * Never lock the camera because server confirmation
 * is delayed. The original transaction remains in
 * IndexedDB and will retry with the same ID.
 */

  }


  // ====================================================
  // BACKGROUND SYNCHRONISATION
  // ====================================================

  async function synchronisePendingTransactions() {

  /*
   * Never allow the online event, retry timer or
   * startup recovery to create competing queue
   * processors.
   */

  if (syncWorkerRunning) {
    return;
  }


  if (
    !db ||
    !navigator.onLine
  ) {

    return;
  }


  syncWorkerRunning =
    true;


  try {
/*
 * Take one snapshot of the unresolved queue.
 *
 * Every transaction present in this snapshot gets
 * at most one processing opportunity during this
 * worker pass.
 *
 * This prevents one difficult transaction from
 * starving later scans while also preventing an
 * unresolved transaction from being selected again
 * immediately in an endless loop.
 */

const queue =
  await getUnresolvedTransactionQueue();


for (
  let index = 0;
  index < queue.length;
  index++
) {

  /*
   * Stop cleanly if connectivity disappears.
   * Remaining transactions stay safely stored
   * for the next worker pass.
   */

  if (!navigator.onLine) {
    break;
  }


  const queuedTransaction =
    queue[index];


  /*
   * Re-read the transaction because another operation
   * may have resolved it since this snapshot was made.
   */

  const current =
    await getLocalTransaction(
      queuedTransaction.transactionId
    );


  if (!current) {
    continue;
  }


  if (
    current.status === "SYNCED" ||
    current.status === "REJECTED" ||
    current.status === "ATTENTION"
  ) {

    continue;
  }


  /*
   * Process this transaction using its ORIGINAL
   * transaction ID and ORIGINAL captured timestamp.
   *
   * processLocalTransaction() never creates a
   * replacement transaction.
   */

  await processLocalTransaction(
    current.transactionId
  );


  /*
   * Whether this transaction resolved or returned
   * to PENDING, move on to the next transaction from
   * this snapshot.
   *
   * Any unresolved transaction will be eligible again
   * on a later worker pass.
   */

  await updateRegistryCounts();
}


  } catch (
    error
  ) {

   console.error(
  "Queue synchronisation error:",
  error
);


/*
 * Saved transactions remain in IndexedDB.
 *
 * Do not overwrite the operator's current scanner
 * display because of a background synchronisation
 * error.
 */

await updateRegistryCounts();


  } finally {

    syncWorkerRunning =
      false;


    await updateRegistryCounts();
  }
}

  function scheduleRetryLoop() {

    if (retryTimer) {

      clearInterval(
        retryTimer
      );
    }


    retryTimer =
      setInterval(
        function() {

          synchronisePendingTransactions();

        },
        RETRY_INTERVAL_MS
      );
  }


  // ====================================================
  // RESOLUTION
  // ====================================================

  function finishResolvedTransaction(
  transactionId
) {

  /*
   * Resolution belongs to the background queue.
   *
   * Never change scanLocked here. A different QR may
   * already be committing to IndexedDB.
   *
   * Never clear activeTransactionId here for the same
   * reason: it may belong to a newer capture.
   */

  updateRegistryCounts();
}


