  // ====================================================
  // REGISTRY COUNTS
  // ====================================================

  async function updateRegistryCounts() {

    if (!db) {
      return;
    }


    const records =
      await getAllLocalTransactions();


    const synced =
      records.filter(
        function(record) {

          return (
            record.status ===
            "SYNCED"
          );
        }
      ).length;


    const pending =
      records.filter(
        function(record) {

          return (
            record.status ===
              "PENDING" ||
            record.status ===
              "VERIFYING" ||
            record.status ===
              "BUSY"
          );
        }
      ).length;


    const attention =
  records.filter(
    function(record) {

      return (
        record.status ===
        "ATTENTION"
      );
    }
  ).length;

    document
      .getElementById(
        "syncedCount"
      )
      .textContent =
      synced;


    document
      .getElementById(
        "pendingCount"
      )
      .textContent =
      pending;


    document
      .getElementById(
        "attentionCount"
      )
      .textContent =
      attention;


    const message =
      document.getElementById(
        "syncMessage"
      );


    if (pending > 0) {

      message.textContent =
        pending +
        " scan" +
        (
          pending === 1
            ? ""
            : "s"
        ) +
        " safely stored and awaiting confirmation.";

    } else {

      message.textContent =
        "No scans are waiting to sync.";
    }
  }


